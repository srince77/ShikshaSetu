# --- Database (Neon Postgres) ---
# Use the pooled connection string (the "-pooler" host in the Neon console).
DATABASE_URL=postgres://user:password@host-pooler.neon.tech/dbname?sslmode=require

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
# Prefer the default AWS credential provider chain (IAM role, shared config,
# etc). Set these only if you need to pin explicit credentials locally.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5

# --- Voice ---
# Primary, for Hindi/Indic quality (register at bhashini.gov.in).
BHASHINI_API_KEY=
BHASHINI_USER_ID=
# Fallback, same AWS credentials as Bedrock above.
# (Amazon Polly / Amazon Transcribe need no separate key.)

# --- Auth ---
# Random 32+ byte secret used to sign session tokens.
SESSION_SECRET=

# Dev-only: when true, API routes accept a hardcoded owner id instead of a
# real session, so other work isn't blocked on auth being finished. Never
# set this in a real deployment.
SESSION_DEV_BYPASS=false
